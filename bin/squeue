#!/usr/bin/env bash
#
# Show the current user's SLURM queue on the cluster.
#
# Usage:
#   bin/squeue                # one snapshot
#   bin/squeue --watch [SECS] # refresh every SECS seconds (default 10)
#
# Reads REMOTE_USER, REMOTE_HOST from .env (repo root).

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ -f "$REPO_ROOT/.env" ]]; then
    # shellcheck disable=SC1091
    source "$REPO_ROOT/.env"
fi

if [[ -z "${REMOTE_USER:-}" ]]; then
    echo "ERROR: REMOTE_USER is not set (copy .env.template to .env)." >&2
    exit 1
fi

REMOTE="${REMOTE_USER}@${REMOTE_HOST}"
FORMAT='%.10i %.22j %.10T %.10M %R'

WATCH_INTERVAL=""
case "${1:-}" in
    "") ;;
    --watch) WATCH_INTERVAL="${2:-10}" ;;
    -h|--help) sed -n '2,9p' "$0"; exit 0 ;;
    *) echo "Unknown argument: $1" >&2; exit 1 ;;
esac

if [[ -n "$WATCH_INTERVAL" ]]; then
    while true; do
        clear
        date
        ssh "$REMOTE" "squeue --me --format='$FORMAT'" || true
        sleep "$WATCH_INTERVAL"
    done
else
    ssh "$REMOTE" "squeue --me --format='$FORMAT'"
fi
